<Window x:Class="Classify8.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Classify8.Localization"
        Title="{loc:Tr main.title}"
        Height="600"
        Width="900"
        WindowStartupLocation="CenterScreen"
        Icon="c8_icon.ico"
        Closing="Window_Closing">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 0. メニューバー -->
            <RowDefinition Height="Auto"/>
            <!-- 1. ツールバー (ボタン類) -->
            <RowDefinition Height="*"/>
            <!-- 2. ルール一覧 -->
            <RowDefinition Height="Auto"/>
            <!-- 3. ステータス -->
            <RowDefinition Height="70"/>
            <!-- 4. 実行ログ -->
        </Grid.RowDefinitions>

        <!-- ============================== -->
        <!-- メニューバー                   -->
        <!-- ============================== -->
        <Menu Grid.Row="0"
              Background="#F0F0F0"
              Padding="5,2"
              Margin="-10,-10,-10,10">
            <!-- 振り分け -->
            <MenuItem Header="{loc:Tr main.menu.sort}">
                <MenuItem Name="miRunSelected"
                          Header="{loc:Tr main.run_selected}"
                          Click="MenuRunSelected_Click"/>
                <MenuItem Header="{loc:Tr main.run_all_menu}"
                          Click="MenuRunAll_Click"/>
                <Separator/>
                <MenuItem Header="{loc:Tr history.title}"
                          Click="MenuHistory_Click"/>
            </MenuItem>

            <!-- 振り分け条件 -->
            <MenuItem Header="{loc:Tr main.menu.rules}">
                <MenuItem Header="{loc:Tr common.add}"
                          Click="BtnAddRule_Click"/>
                <MenuItem Header="{loc:Tr common.edit}"
                          Click="BtnEditRule_Click"/>
                <MenuItem Header="{loc:Tr common.delete}"
                          Click="BtnDeleteRule_Click"/>
                <Separator/>
                <MenuItem Name="miCopy"
                          Header="{loc:Tr common.copy}"
                          Click="MenuCopy_Click"/>
                <MenuItem Name="miCut"
                          Header="{loc:Tr common.cut}"
                          Click="MenuCut_Click"/>
                <MenuItem Name="miPaste"
                          Header="{loc:Tr common.paste}"
                          Click="MenuPaste_Click"/>
                <Separator/>
                <MenuItem Header="{loc:Tr main.check_all}"
                          Click="MenuCheckAll_Click"/>
                <MenuItem Header="{loc:Tr main.uncheck_all}"
                          Click="MenuUncheckAll_Click"/>
                <Separator/>
                <MenuItem Name="miOpenSource"
                          Header="{loc:Tr common.open_source}"
                          Click="MenuOpenSource_Click"/>
                <MenuItem Name="miOpenDest"
                          Header="{loc:Tr common.open_dest}"
                          Click="MenuOpenDest_Click"/>
            </MenuItem>

            <!-- 設定 -->
            <MenuItem Header="{loc:Tr main.menu.settings}">
                <MenuItem Header="{loc:Tr main.menu.options}"
                          Click="BtnSettings_Click"/>
            </MenuItem>

            <MenuItem Header="{loc:Tr main.menu.help}">
                <MenuItem Header="{loc:Tr main.menu.help_contents}"
                        Click="MenuHelp_Click"/>
                <Separator/>
                <MenuItem Header="{loc:Tr main.menu.about}"
                        Click="MenuAbout_Click"/>
            </MenuItem>
        </Menu>

        <!-- ============================== -->
        <!-- 既存のツールバー (※Grid.Row="1") -->
        <!-- ============================== -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="0,0,0,10">
            <Button Name="btnAddRule"
                    Content="{loc:Tr main.btn.add_rule}"
                    Width="100"
                    Height="30"
                    Margin="0,0,10,0"
                    Click="BtnAddRule_Click"/>
            <Button Name="btnEditRule"
                    Content="{loc:Tr common.edit}"
                    Width="80"
                    Height="30"
                    Margin="0,0,10,0"
                    Click="BtnEditRule_Click"/>
            <Button Name="btnDeleteRule"
                    Content="{loc:Tr common.delete}"
                    Width="80"
                    Height="30"
                    Margin="0,0,30,0"
                    Click="BtnDeleteRule_Click"/>
            <Button Name="btnPreset"
                    Content="{loc:Tr main.btn.presets}"
                    Width="120"
                    Height="30"
                    Margin="0,0,10,0"
                    Click="BtnPreset_Click"/>
            <Button Name="btnRunAll"
                    Content="{loc:Tr main.btn.run_all}"
                    Width="220"
                    Height="30"
                    Margin="0,0,20,0"
                    Background="#FF4CAF50"
                    Foreground="White"
                    FontWeight="Bold"
                    Click="MenuRunAll_Click"/>
        </StackPanel>

        <!-- 2. ルール一覧と操作ボタン (中央) -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="50"/>
                <!-- ボタン用の幅 -->
            </Grid.ColumnDefinitions>

            <ListView x:Name="lvRules"
                      Grid.Column="0"
                      SelectionMode="Extended"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      AllowDrop="True"
                      SelectionChanged="LvRules_SelectionChanged"
                      PreviewMouseLeftButtonDown="LvRules_PreviewMouseLeftButtonDown"
                      PreviewMouseMove="LvRules_PreviewMouseMove"
                      DragEnter="LvRules_DragEnter"
                      Drop="LvRules_Drop"
                      PreviewKeyDown="LvRules_PreviewKeyDown">

                <ListView.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{loc:Tr common.add}"
                                  Click="BtnAddRule_Click"/>
                        <MenuItem Name="ctxEdit"
                                  Header="{loc:Tr common.edit}"
                                  Click="BtnEditRule_Click"/>
                        <MenuItem Name="ctxDelete"
                                  Header="{loc:Tr common.delete}"
                                  Click="BtnDeleteRule_Click"/>
                        <Separator/>
                        <MenuItem Name="ctxCopy"
                                  Header="{loc:Tr common.copy}"
                                  Click="MenuCopy_Click"/>
                        <MenuItem Name="ctxCut"
                                  Header="{loc:Tr common.cut}"
                                  Click="MenuCut_Click"/>
                        <MenuItem Name="ctxPaste"
                                  Header="{loc:Tr common.paste}"
                                  Click="MenuPaste_Click"/>
                        <Separator/>
                        <MenuItem Name="ctxRun"
                                  Header="{loc:Tr main.run_selected}"
                                  Click="MenuRunSelected_Click"/>
                        <Separator/>
                        <MenuItem Name="ctxOpenSource"
                                  Header="{loc:Tr common.open_source}"
                                  Click="MenuOpenSource_Click"/>
                        <MenuItem Name="ctxOpenDest"
                                  Header="{loc:Tr common.open_dest}"
                                  Click="MenuOpenDest_Click"/>
                    </ContextMenu>
                </ListView.ContextMenu>

                <ListView.Resources>
                    <!-- 行全体（横線と選択時の色）の完全カスタムスタイル -->
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment"
                                Value="Stretch"/>
                        <Setter Property="VerticalContentAlignment"
                                Value="Stretch"/>
                        <Setter Property="Background"
                                Value="Transparent"/>
                        <Setter Property="BorderBrush"
                                Value="LightGray"/>
                        <Setter Property="BorderThickness"
                                Value="0,0,0,1"/>
                        <!-- 下部に横線を引く -->
                        <Setter Property="Foreground"
                                Value="Black"/>

                        <!-- OSの標準エフェクトを無効化し、独自のデザインを適用する -->
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}">
                                        <GridViewRowPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>

                        <!-- マウスオーバー時と選択時の色をトリガーで強制設定 -->
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter Property="Background"
                                        Value="#E3F2FD"/>
                                <!-- ホバー時は薄いブルー -->
                            </Trigger>
                            <Trigger Property="IsSelected"
                                     Value="True">
                                <Setter Property="Background"
                                        Value="#1976D2"/>
                                <!-- 選択時は濃いブルー -->
                                <Setter Property="Foreground"
                                        Value="White"/>
                                <!-- 文字色は白 -->
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListView.Resources>

                <ListView.View>
                    <GridView>
                        <!-- 有効 (チェックボックス) -->
                        <GridViewColumn Header="{loc:Tr main.col.enabled}"
                                        Width="65">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="LightGray"
                                            BorderThickness="0,0,1,0"
                                            Margin="-6,-2,-9,-2">
                                        <CheckBox IsChecked="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Click="RuleCheckBox_Click"/>
                                    </Border>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- 名称 -->
                        <GridViewColumn Header="{loc:Tr common.name}"
                                        Width="150">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="LightGray"
                                            BorderThickness="0,0,1,0"
                                            Margin="-6,-2,-9,-2"
                                            Padding="6,2,6,2">
                                        <TextBlock Text="{Binding RuleName}"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- 振り分け元 -->
                        <GridViewColumn Header="{loc:Tr common.source}"
                                        Width="200">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="LightGray"
                                            BorderThickness="0,0,1,0"
                                            Margin="-6,-2,-9,-2"
                                            Padding="6,2,6,2">
                                        <TextBlock Text="{Binding SourcePathDisplay}"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- 検索条件 -->
                        <GridViewColumn Header="{loc:Tr main.col.condition}"
                                        Width="200">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="LightGray"
                                            BorderThickness="0,0,1,0"
                                            Margin="-6,-2,-9,-2"
                                            Padding="6,2,6,2">
                                        <TextBlock Text="{Binding SearchCondition}"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- 振り分け先 -->
                        <GridViewColumn Header="{loc:Tr common.dest}"
                                        Width="250">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <!-- 最後の列は縦線不要なので BorderThickness="0"、マージンも右側は余裕を持たせる -->
                                    <Border BorderBrush="LightGray"
                                            BorderThickness="0"
                                            Margin="-6,-2,0,-2"
                                            Padding="6,2,6,2">
                                        <TextBlock Text="{Binding DestPathDisplay}"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>

            <!-- 順序入れ替えボタン -->
            <StackPanel Grid.Column="1"
                        Orientation="Vertical"
                        VerticalAlignment="Center"
                        Margin="5,0,0,0">
                <Button Name="btnMoveUp"
                        Content="▲"
                        Height="40"
                        Margin="0,0,0,10"
                        Click="BtnMoveUp_Click"
                        ToolTip="{loc:Tr main.tip.move_up}"/>
                <Button Name="btnMoveDown"
                        Content="▼"
                        Height="40"
                        Click="BtnMoveDown_Click"
                        ToolTip="{loc:Tr main.tip.move_down}"/>
            </StackPanel>
        </Grid>

        <!-- 3. ステータスとプログレスバー (下部) -->
        <Grid Grid.Row="3"
              Margin="0,10,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Name="txtStatus"
                       Grid.Column="0"
                       Text="{loc:Tr common.waiting}"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"
                       Width="150"/>
            <ProgressBar Name="progressBar"
                         Grid.Column="1"
                         Height="20"
                         Minimum="0"
                         Maximum="100"
                         Value="0"/>
        </Grid>

        <!-- 4. 実行ログ (最下部) -->
        <TextBox Grid.Row="4"
                 Name="txtLog"
                 IsReadOnly="True"
                 VerticalScrollBarVisibility="Auto"
                 Background="#F0F0F0"
                 TextWrapping="Wrap"/>
    </Grid>
</Window>