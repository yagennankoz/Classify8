<Application x:Class="Classify8.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
     <Application.Resources>

          <!-- スペルチェック候補などを出さない、シンプルな右クリックメニュー -->
          <ContextMenu x:Key="PlainTextBoxMenu">
               <MenuItem Header="切り取り(_T)"
                         Command="ApplicationCommands.Cut"/>
               <MenuItem Header="コピー(_C)"
                         Command="ApplicationCommands.Copy"/>
               <MenuItem Header="貼り付け(_P)"
                         Command="ApplicationCommands.Paste"/>
               <Separator/>
               <MenuItem Header="すべて選択(_A)"
                         Command="ApplicationCommands.SelectAll"/>
          </ContextMenu>

          <!-- 全 TextBox に適用 -->
          <Style TargetType="TextBox">
               <Setter Property="SpellCheck.IsEnabled"
                         Value="False"/>
               <Setter Property="ContextMenu"
                         Value="{StaticResource PlainTextBoxMenu}"/>
          </Style>

     </Application.Resources>
</Application>