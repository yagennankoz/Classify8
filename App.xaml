<Application x:Class="Classify8.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Classify8.Localization"
             StartupUri="MainWindow.xaml">
     <Application.Resources>

          <!-- スペルチェック候補などを出さない、シンプルな右クリックメニュー。
               テキストボックスごとに作り (x:Shared=False)、コマンドの対象は右クリックされたテキストボックスにする -->
          <ContextMenu x:Key="PlainTextBoxMenu" x:Shared="False">
               <MenuItem Header="{loc:Tr textmenu.cut}"
                         Command="ApplicationCommands.Cut"
                         CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
               <MenuItem Header="{loc:Tr textmenu.copy}"
                         Command="ApplicationCommands.Copy"
                         CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
               <MenuItem Header="{loc:Tr textmenu.paste}"
                         Command="ApplicationCommands.Paste"
                         CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
               <Separator/>
               <MenuItem Header="{loc:Tr textmenu.select_all}"
                         Command="ApplicationCommands.SelectAll"
                         CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
          </ContextMenu>

          <!-- 全 TextBox に適用 -->
          <Style TargetType="TextBox">
               <Setter Property="SpellCheck.IsEnabled"
                         Value="False"/>
               <Setter Property="ContextMenu"
                         Value="{StaticResource PlainTextBoxMenu}"/>
          </Style>

     </Application.Resources>
</Application>
