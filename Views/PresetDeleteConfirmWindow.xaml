<Window x:Class="Classify8.Views.PresetDeleteConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Classify8.Localization"
        Title="{loc:Tr presetdel.title}" Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{loc:Tr presetdel.message}"
                   TextWrapping="Wrap" FontSize="14"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
            <Button Content="{loc:Tr presetdel.convert}" MinWidth="150" Padding="10,0" Height="35" Margin="0,0,10,0" Background="#FF4CAF50" Foreground="White" FontWeight="Bold" Click="BtnConvert_Click"/>
            <Button Content="{loc:Tr presetdel.force}" MinWidth="120" Padding="10,0" Height="35" Margin="0,0,10,0" Background="#FFF44336" Foreground="White" Click="BtnForce_Click"/>
            <Button Content="{loc:Tr common.cancel}" MinWidth="90" Padding="10,0" Height="35" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
