<Window x:Class="Classify8.Views.PresetManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Classify8.Localization"
        Title="{loc:Tr presets.title}"
        Height="350"
        Width="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <!-- 左側：リストと追加・削除ボタン -->
        <Grid Grid.Column="0"
                Margin="0,0,15,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ListView Name="lvPresets"
                    Grid.Row="0"
                    SelectionChanged="LvPresets_SelectionChanged">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="{loc:Tr common.name}"
                                DisplayMemberBinding="{Binding AliasName}"
                                Width="100"/>
                        <GridViewColumn Header="{loc:Tr presets.col.path}"
                                DisplayMemberBinding="{Binding DirectoryPath}"
                                Width="120"/>
                    </GridView>
                </ListView.View>
            </ListView>

            <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="0,10,0,0"
                    HorizontalAlignment="Center">
                <Button Name="btnAdd"
                        Content="{loc:Tr presets.btn.add}"
                        MinWidth="80" Padding="8,0"
                        Height="25"
                        Margin="0,0,10,0"
                        Click="BtnAdd_Click"/>
                <Button Name="btnDelete"
                        Content="{loc:Tr common.delete}"
                        MinWidth="60" Padding="8,0"
                        Height="25"
                        Click="BtnDelete_Click"/>
            </StackPanel>
        </Grid>

        <!-- 右側：編集エリア -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                    Text="{loc:Tr presets.label.alias}"
                    FontWeight="Bold"
                    Margin="0,0,0,5"/>
            <TextBox Grid.Row="1"
                    Name="txtAliasName"
                    Height="25"
                    Margin="0,0,0,15"
                    TextChanged="Txt_TextChanged"/>

            <TextBlock Grid.Row="2"
                    Text="{loc:Tr presets.label.path}"
                    FontWeight="Bold"
                    Margin="0,0,0,5"/>
            <Grid Grid.Row="3"
                    Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                        Name="txtDirectoryPath"
                        Height="25"
                        Margin="0,0,5,0"
                        TextChanged="Txt_TextChanged">
                    <TextBox.ToolTip>
                        <ToolTip>
                            <TextBlock>
                                <Run FontWeight="Bold"
                                        Text="{loc:Tr tags.title}"/><LineBreak/>
                                <Run Text="{loc:Tr tags.year}"/><LineBreak/>
                                <Run Text="{loc:Tr tags.month_day}"/><LineBreak/>
                                <Run Text="{loc:Tr tags.name}"/><LineBreak/>
                                <Run Text="{loc:Tr tags.cond}"/><LineBreak/>
                                <Run Foreground="Gray"
                                        Text="{loc:Tr tags.case}"/><LineBreak/>
                                <Run Foreground="#D32F2F"
                                        Text="{loc:Tr presets.tags.file_note}"/>
                            </TextBlock>
                        </ToolTip>
                    </TextBox.ToolTip>
                </TextBox>
                <Button Grid.Column="1"
                        Content="{loc:Tr common.browse}"
                        MinWidth="60" Padding="8,0"
                        Height="25"
                        Click="BtnBrowse_Click"/>
            </Grid>

            <StackPanel Grid.Row="5"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
                <Button Name="btnSave"
                        Content="{loc:Tr common.save_close}"
                        MinWidth="100" Padding="8,0"
                        Height="30"
                        Margin="0,0,10,0"
                        Background="#FF4CAF50"
                        Foreground="White"
                        FontWeight="Bold"
                        Click="BtnSave_Click"/>
                <Button Name="btnCancel"
                        Content="{loc:Tr common.cancel}"
                        MinWidth="80" Padding="8,0"
                        Height="30"
                        Click="BtnCancel_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>