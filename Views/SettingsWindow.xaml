<Window x:Class="Classify8.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Classify8.Localization"
        Title="{loc:Tr settings.title}" Width="500" SizeToContent="Height" MinHeight="350"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" Margin="0,0,0,15">
            <!-- 【同名ファイルの処理】 -->
            <TabItem Header="{loc:Tr settings.tab.conflict}">
                <StackPanel Margin="15">
                    <TextBlock Text="{loc:Tr settings.same_size}" FontWeight="Bold" Margin="0,0,0,5"/>
                    <StackPanel Margin="15,0,0,15">
                        <RadioButton Name="rbSameKeepNewer" Content="{loc:Tr settings.keep_newer}" Margin="0,0,0,5"/>
                        <RadioButton Name="rbSameKeepOlder" Content="{loc:Tr settings.keep_older}" Margin="0,0,0,5"/>
                        <RadioButton Name="rbSameRename" Content="{loc:Tr settings.rename}" Margin="0,0,0,5"/>
                        <RadioButton Name="rbSameSkip" Content="{loc:Tr settings.skip}"/>
                    </StackPanel>

                    <TextBlock Text="{loc:Tr settings.diff_size}" FontWeight="Bold" Margin="0,0,0,5"/>
                    <StackPanel Margin="15,0,0,0">
                        <RadioButton Name="rbDiffKeepNewer" Content="{loc:Tr settings.keep_newer}" Margin="0,0,0,5"/>
                        <RadioButton Name="rbDiffKeepOlder" Content="{loc:Tr settings.keep_older}" Margin="0,0,0,5"/>
                        <RadioButton Name="rbDiffRename" Content="{loc:Tr settings.rename}" Margin="0,0,0,5"/>
                        <RadioButton Name="rbDiffSkip" Content="{loc:Tr settings.skip}"/>
                    </StackPanel>

                    <Separator Margin="0,15,0,10"/>
                    <CheckBox Name="chkCompareContent" Margin="0,0,0,3">
                        <TextBlock TextWrapping="Wrap"
                                   Text="{loc:Tr settings.compare_content}"/>
                    </CheckBox>
                    <TextBlock Margin="20,0,0,0" Foreground="Gray" FontSize="11" TextWrapping="Wrap"
                               Text="{loc:Tr settings.compare_content_note}"/>
                </StackPanel>
            </TabItem>

            <!-- 【振り分けないファイル】 -->
            <TabItem Header="{loc:Tr settings.tab.ng}">
                <StackPanel Margin="15">
                    <TextBlock Text="{loc:Tr settings.ng_label}" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBlock Text="{loc:Tr settings.ng_note}" 
                               Foreground="Gray" FontSize="11" Margin="0,0,0,5" TextWrapping="Wrap"/>
                    <TextBox Name="txtNgKeywords" Height="70" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                </StackPanel>
            </TabItem>

            <!-- 【実行条件】 -->
            <TabItem Header="{loc:Tr settings.tab.run}">
                <StackPanel Margin="15">
                    <TextBlock Text="{loc:Tr settings.periodic_label}" FontWeight="Bold" Margin="0,0,0,5"/>
                    <StackPanel Margin="15,0,0,15">
                        <RadioButton Name="rbPeriodicOff" GroupName="PeriodicGrp" Content="{loc:Tr settings.periodic_off}" Margin="0,0,0,5" Checked="Periodic_Changed" Unchecked="Periodic_Changed"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Name="rbPeriodicOn" GroupName="PeriodicGrp" Content="{loc:Tr settings.periodic_on}" VerticalAlignment="Center" Checked="Periodic_Changed" Unchecked="Periodic_Changed"/>
                            <TextBox Name="txtPeriodicMinutes" Width="40" Height="25" VerticalContentAlignment="Center" Margin="5,0"/>
                            <TextBlock Text="{loc:Tr settings.minutes}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="{loc:Tr settings.other}" FontWeight="Bold" Margin="0,0,0,5"/>
                    <StackPanel Margin="15,0,0,0">
                        <CheckBox Name="chkMoveToRecycleBin" Content="{loc:Tr settings.recycle}" Margin="0,0,0,8"/>
                        <CheckBox Name="chkAutoCreateDest" Content="{loc:Tr settings.auto_create}" Margin="0,0,0,8"/>
                        <CheckBox Name="chkStartMinimized" Content="{loc:Tr settings.start_minimized}" Margin="0,0,0,8"/>
                        <CheckBox Name="chkSilentReadOnly" Content="{loc:Tr settings.silent_readonly}" Margin="0,0,0,8"/>
                        <CheckBox Name="chkConfirmDoubleClick" Content="{loc:Tr settings.confirm_dblclick}" Margin="0,0,0,8"/>
                        
                        <StackPanel Orientation="Horizontal">
                            <CheckBox Name="chkLimitHistory" Content="{loc:Tr settings.limit_history}" VerticalAlignment="Center" Checked="HistoryLimit_Changed" Unchecked="HistoryLimit_Changed"/>
                            <TextBox Name="txtHistoryLimit" Width="40" Height="25" VerticalContentAlignment="Center" Margin="5,0"/>
                            <TextBlock Text="{loc:Tr settings.hundreds}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <TabItem Header="{loc:Tr settings.tab.priority}">
                <StackPanel Margin="15">
                    <TextBlock Text="{loc:Tr settings.priority_label}" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBlock Text="{loc:Tr settings.priority_note}" Foreground="Gray" FontSize="11" Margin="0,0,0,15"/>
                    
                    <StackPanel Margin="15,0,0,0">
                        <RadioButton Name="rbPriorityHigh" Content="{loc:Tr settings.priority_high}" Margin="0,0,0,8"/>
                        <RadioButton Name="rbPriorityNormal" Content="{loc:Tr settings.priority_normal}" Margin="0,0,0,8"/>
                        <RadioButton Name="rbPriorityLow" Content="{loc:Tr settings.priority_low}" Margin="0,0,0,8"/>
                        <RadioButton Name="rbPriorityIdle" Content="{loc:Tr settings.priority_idle}" Margin="0,0,0,8"/>
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <!-- 【表示 / Display】 -->
            <TabItem Header="{loc:Tr settings.tab.display}">
                <StackPanel Margin="15">
                    <TextBlock Text="{loc:Tr settings.language_label}" FontWeight="Bold" Margin="0,0,0,5"/>
                    <ComboBox Name="cmbLanguage" Width="260" HorizontalAlignment="Left" Margin="15,0,0,8"
                              DisplayMemberPath="DisplayName" SelectedValuePath="Code"/>
                    <TextBlock Text="{loc:Tr settings.language_note}" Foreground="Gray" FontSize="11" Margin="15,0,0,0"/>
                </StackPanel>
            </TabItem>

            <!-- 【特殊】 -->
            <TabItem Header="{loc:Tr settings.tab.special}">
                <StackPanel Margin="15">
                    <StackPanel Orientation="Horizontal" Margin="15,0,0,0">
                        <TextBlock Text="{loc:Tr settings.import_label}" VerticalAlignment="Center" Margin="0,0,15,0"/>
                        <Button Content="{loc:Tr settings.import_btn}" Width="100" Height="25" Click="BtnImportLegacy_Click"/>
                    </StackPanel>
                </StackPanel>
            </TabItem>
        </TabControl>

        <!-- ボタン領域 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{loc:Tr common.save_close}" Width="120" Height="35" Margin="0,0,10,0" Background="#FF4CAF50" Foreground="White" FontWeight="Bold" Click="BtnSave_Click"/>
            <Button Content="{loc:Tr common.cancel}" Width="90" Height="35" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>