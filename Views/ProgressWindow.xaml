<Window x:Class="Classify8.Views.ProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Classify8.Localization"
        Title="{loc:Tr progress.title}"
        Height="250"
        Width="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Closing="Window_Closing">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{loc:Tr progress.label.rule}"
                   FontWeight="Bold"
                   Grid.Row="0"
                   Margin="0,0,0,5"/>
        <TextBlock Name="txtRuleName"
                   Text="{loc:Tr progress.preparing}"
                   Grid.Row="1"
                   Margin="10,0,0,15"
                   Foreground="#1976D2"
                   FontWeight="Bold"/>

        <TextBlock Text="{loc:Tr progress.label.file}"
                   FontWeight="Bold"
                   Grid.Row="2"
                   Margin="0,0,0,5"/>
        <TextBlock Name="txtFileName"
                   Text="{loc:Tr common.waiting}"
                   Grid.Row="3"
                   Margin="10,0,0,15"
                   TextTrimming="CharacterEllipsis"
                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>

        <StackPanel Grid.Row="4"
                    VerticalAlignment="Center">
            <!-- 無限スクロール状態のプログレスバー -->
            <ProgressBar Name="progressBar"
                         Height="20"
                         IsIndeterminate="True"
                         Margin="0,0,0,10"/>
            <TextBlock Name="txtCounts"
                       Text="{loc:Tr progress.counts_initial}"
                       HorizontalAlignment="Center"
                       FontWeight="Bold"/>
        </StackPanel>

        <Button Name="btnCancel"
                Grid.Row="5"
                Content="{loc:Tr progress.cancel}"
                Height="35"
                MinWidth="150"
                Padding="10,0"
                HorizontalAlignment="Center"
                Background="#FFF44336"
                Foreground="White"
                FontWeight="Bold"
                Click="BtnCancel_Click"/>
    </Grid>
</Window>
