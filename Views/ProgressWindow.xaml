<Window x:Class="Classify8.Views.ProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="振り分け実行中..."
        Height="250"
        Width="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Closing="Window_Closing">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="処理中の振り分け条件:"
                   FontWeight="Bold"
                   Grid.Row="0"
                   Margin="0,0,0,5"/>
        <TextBlock Name="txtRuleName"
                   Text="準備中..."
                   Grid.Row="1"
                   Margin="10,0,0,15"
                   Foreground="#1976D2"
                   FontWeight="Bold"/>

        <TextBlock Text="作業中のファイル:"
                   FontWeight="Bold"
                   Grid.Row="2"
                   Margin="0,0,0,5"/>
        <TextBlock Name="txtFileName"
                   Text="待機中..."
                   Grid.Row="3"
                   Margin="10,0,0,15"
                   TextTrimming="CharacterEllipsis"
                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>

        <StackPanel Grid.Row="4"
                    VerticalAlignment="Center">
            <!-- 無限スクロール状態のプログレスバー -->
            <ProgressBar Name="progressBar"
                         Height="20"
                         IsIndeterminate="True"
                         Margin="0,0,0,10"/>
            <TextBlock Name="txtCounts"
                       Text="処理完了: 0 件  /  エラー: 0 件"
                       HorizontalAlignment="Center"
                       FontWeight="Bold"/>
        </StackPanel>

        <Button Name="btnCancel"
                Grid.Row="5"
                Content="中 止 (キャンセル)"
                Height="35"
                Width="150"
                HorizontalAlignment="Center"
                Background="#FFF44336"
                Foreground="White"
                FontWeight="Bold"
                Click="BtnCancel_Click"/>
    </Grid>
</Window>