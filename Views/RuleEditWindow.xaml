<Window x:Class="Classify8.Views.RuleEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Classify8.Localization"
        Title="{loc:Tr rule.title}"
        Width="680"
        MinHeight="400"
        SizeToContent="Height"
        MaxHeight="{Binding Path=Height, Source={x:Static SystemParameters.WorkArea}}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">

        <Grid Margin="15">
                <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <!-- 0. スクロール領域 (設定項目) -->
                        <RowDefinition Height="Auto"/>
                        <!-- 1. ボタン領域 (常に下部に固定) -->
                </Grid.RowDefinitions>

                <!-- ============================== -->
                <!-- スクロール可能な設定エリア     -->
                <!-- ============================== -->
                <ScrollViewer Grid.Row="0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Margin="0,0,0,15"
                              Padding="0,0,10,0">
                        <Grid>
                                <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <!-- メイン項目 -->
                                        <RowDefinition Height="Auto"/>
                                        <!-- タブ項目 -->
                                </Grid.RowDefinitions>

                                <!-- ============================== -->
                                <!-- メイン項目 (常に表示)          -->
                                <!-- ============================== -->
                                <Grid Grid.Row="0">
                                        <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- 有効・名称 -->
                                        <TextBlock Grid.Row="0"
                                                   Grid.Column="0"
                                                   Text="{loc:Tr rule.label.name}"
                                                   VerticalAlignment="Center"
                                                   FontWeight="Bold"/>
                                        <StackPanel Grid.Row="0"
                                                    Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    Margin="0,0,0,10">
                                                <CheckBox Name="chkIsEnabled"
                                                          Content="{loc:Tr rule.enabled}"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,15,0"/>
                                                <TextBox Name="txtRuleName"
                                                         Width="300"
                                                         Height="25"
                                                         VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- 振り分け元 -->
                                        <TextBlock Grid.Row="1"
                                                   Grid.Column="0"
                                                   Text="{loc:Tr rule.label.source}"
                                                   VerticalAlignment="Top"
                                                   Margin="0,5,0,0"
                                                   FontWeight="Bold"/>
                                        <Border Grid.Row="1"
                                                Grid.Column="1"
                                                BorderBrush="LightGray"
                                                BorderThickness="1"
                                                Padding="10"
                                                Margin="0,0,0,10">
                                                <StackPanel>
                                                        <RadioButton Name="rbSourcePreset"
                                                                     Content="{loc:Tr rule.use_preset}"
                                                                     GroupName="SourceGrp"
                                                                     Checked="SourceMode_Changed"
                                                                     Unchecked="SourceMode_Changed"
                                                                     Margin="0,0,0,5"/>
                                                        <ComboBox Name="cmbSourcePreset"
                                                                  Height="25"
                                                                  Margin="20,0,0,10"
                                                                  SelectedValuePath="Id">
                                                                <ComboBox.ItemTemplate>
                                                                        <DataTemplate>
                                                                                <TextBlock>
                                            <Run Text="{Binding AliasName}"/>
                                            <Run Text=" ("
                                                                                        Foreground="Gray"/>
                                            <Run Text="{Binding DirectoryPath}"
                                                                                        Foreground="Gray"/>
                                            <Run Text=")"
                                                                                        Foreground="Gray"/>
                                                                                </TextBlock>
                                                                        </DataTemplate>
                                                                </ComboBox.ItemTemplate>
                                                        </ComboBox>

                                                        <RadioButton Name="rbSourceCustom"
                                                                     Content="{loc:Tr rule.use_custom}"
                                                                     GroupName="SourceGrp"
                                                                     Checked="SourceMode_Changed"
                                                                     Unchecked="SourceMode_Changed"
                                                                     Margin="0,0,0,5"/>
                                                        <Grid Margin="20,0,0,5">
                                                                <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBox Name="txtSourceCustom"
                                                                         Grid.Column="0"
                                                                         Height="25"
                                                                         Margin="0,0,5,0">
                                                                        <TextBox.ToolTip>
                                                                                <ToolTip>
                                                                                        <TextBlock>
                                                <Run FontWeight="Bold"
                                                                                                Text="{loc:Tr tags.title}"/><LineBreak/>
                                                <Run Text="{loc:Tr tags.year}"/><LineBreak/>
                                                <Run Text="{loc:Tr tags.month_day}"/><LineBreak/>
                                                <Run Text="{loc:Tr tags.name}"/><LineBreak/>
                                                <Run Text="{loc:Tr tags.cond}"/><LineBreak/>
                                                <Run Foreground="Gray"
                                                                                                Text="{loc:Tr tags.case}"/><LineBreak/>
                                                <Run Foreground="#D32F2F"
                                                                                                Text="{loc:Tr rule.tags.file_note}"/>
                                                                                        </TextBlock>
                                                                                </ToolTip>
                                                                        </TextBox.ToolTip>
                                                                </TextBox>
                                                                <Button Name="btnSourceBrowse"
                                                                        Grid.Column="1"
                                                                        Content="{loc:Tr common.browse}"
                                                                        Width="60"
                                                                        Height="25"
                                                                        Click="BtnSourceBrowse_Click"/>
                                                        </Grid>
                                                        <CheckBox Name="chkSearchSubDirs"
                                                                  Content="{loc:Tr rule.subdirs}"
                                                                  Margin="20,5,0,0"
                                                                  FontWeight="Bold"
                                                                  Foreground="#1976D2"/>
                                                </StackPanel>
                                        </Border>

                                        <!-- 振り分け先 -->
                                        <TextBlock Grid.Row="2"
                                                   Grid.Column="0"
                                                   Text="{loc:Tr rule.label.dest}"
                                                   VerticalAlignment="Top"
                                                   Margin="0,5,0,0"
                                                   FontWeight="Bold"/>
                                        <Border Grid.Row="2"
                                                Grid.Column="1"
                                                BorderBrush="LightGray"
                                                BorderThickness="1"
                                                Padding="10"
                                                Margin="0,0,0,10">
                                                <StackPanel>
                                                        <RadioButton Name="rbDestPreset"
                                                                     Content="{loc:Tr rule.use_preset}"
                                                                     GroupName="DestGrp"
                                                                     Checked="DestMode_Changed"
                                                                     Unchecked="DestMode_Changed"
                                                                     Margin="0,0,0,5"/>
                                                        <ComboBox Name="cmbDestPreset"
                                                                  Height="25"
                                                                  Margin="20,0,0,10"
                                                                  SelectedValuePath="Id">
                                                                <ComboBox.ItemTemplate>
                                                                        <DataTemplate>
                                                                                <TextBlock>
                                            <Run Text="{Binding AliasName}"/>
                                            <Run Text=" ("
                                                                                        Foreground="Gray"/>
                                            <Run Text="{Binding DirectoryPath}"
                                                                                        Foreground="Gray"/>
                                            <Run Text=")"
                                                                                        Foreground="Gray"/>
                                                                                </TextBlock>
                                                                        </DataTemplate>
                                                                </ComboBox.ItemTemplate>
                                                        </ComboBox>

                                                        <RadioButton Name="rbDestCustom"
                                                                     Content="{loc:Tr rule.use_custom}"
                                                                     GroupName="DestGrp"
                                                                     Checked="DestMode_Changed"
                                                                     Unchecked="DestMode_Changed"
                                                                     Margin="0,0,0,5"/>
                                                        <Grid Margin="20,0,0,5">
                                                                <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBox Name="txtDestCustom"
                                                                         Grid.Column="0"
                                                                         Height="25"
                                                                         Margin="0,0,5,0">
                                                                        <TextBox.ToolTip>
                                                                                <ToolTip>
                                                                                        <TextBlock>
                                                <Run FontWeight="Bold"
                                                                                                Text="{loc:Tr tags.title}"/><LineBreak/>
                                                <Run Text="{loc:Tr tags.year}"/><LineBreak/>
                                                <Run Text="{loc:Tr tags.month_day}"/><LineBreak/>
                                                <Run Text="{loc:Tr tags.fyear}"/><LineBreak/>
                                                <Run Text="{loc:Tr tags.fmonth_day}"/><LineBreak/>
                                                <Run Text="{loc:Tr tags.name}"/><LineBreak/>
                                                <Run Text="{loc:Tr tags.cond}"/><LineBreak/>
                                                <Run Foreground="Gray"
                                                                                                Text="{loc:Tr tags.case}"/>
                                                                                        </TextBlock>
                                                                                </ToolTip>
                                                                        </TextBox.ToolTip>
                                                                </TextBox>
                                                                <Button Name="btnDestBrowse"
                                                                        Grid.Column="1"
                                                                        Content="{loc:Tr common.browse}"
                                                                        Width="60"
                                                                        Height="25"
                                                                        Click="BtnDestBrowse_Click"/>
                                                        </Grid>
                                                        <CheckBox Name="chkIsCopy"
                                                                  Content="{loc:Tr rule.copy_instead}"
                                                                  Margin="20,5,0,0"
                                                                  FontWeight="Bold"
                                                                  Foreground="#D32F2F"/>
                                                </StackPanel>
                                        </Border>

                                        <TextBlock Grid.Row="3"
                                                   Grid.Column="0"
                                                   Text="{loc:Tr rule.label.condition}"
                                                   VerticalAlignment="Top"
                                                   Margin="0,5,0,0"
                                                   FontWeight="Bold"
                                                   Foreground="#1976D2"/>
                                        <StackPanel Grid.Row="3"
                                                    Grid.Column="1"
                                                    Margin="0,0,0,10">
                                                <TextBox Name="txtSearchCondition"
                                                         Height="28"
                                                         BorderBrush="#1976D2"
                                                         BorderThickness="2"
                                                         Background="#F8FBFF"
                                                         Padding="3,0"
                                                         VerticalContentAlignment="Center"
                                                         FontSize="13"/>
                                                <TextBlock Foreground="Gray"
                                                           FontSize="11"
                                                           Margin="0,4,0,0"
                                                           TextWrapping="Wrap">
                            <Run Text="{loc:Tr rule.cond_help1}"/><LineBreak/>
                            <Run Text="{loc:Tr rule.cond_help2}"/>
                                                </TextBlock>
                                        </StackPanel>
                                </Grid>

                                <!-- ============================== -->
                                <!-- タブ項目 (オプション)          -->
                                <!-- ============================== -->
                                <TabControl Grid.Row="1"
                                            Margin="0,5,0,0">
                                        <!-- 【一般】 -->
                                        <TabItem Header="{loc:Tr rule.tab.general}">
                                                <StackPanel Margin="15">
                                                        <CheckBox Name="chkIgnoreCase"
                                                                  Content="{loc:Tr rule.ignore_case}"
                                                                  Margin="0,0,0,8"/>
                                                        <CheckBox Name="chkIgnoreWidth"
                                                                  Content="{loc:Tr rule.ignore_width}"
                                                                  Margin="0,0,0,8"/>
                                                        <CheckBox Name="chkIgnoreKana"
                                                                  Content="{loc:Tr rule.ignore_kana}"
                                                                  Margin="0,0,0,8"/>
                                                        <CheckBox Name="chkDoNotSaveHistory"
                                                                  Content="{loc:Tr rule.no_history}"
                                                                  Margin="0,0,0,20"/>

                                                        <TextBlock Text="{loc:Tr rule.label.target}"
                                                                   FontWeight="Bold"
                                                                   Margin="0,0,0,5"/>
                                                        <ComboBox Name="cmbTargetType"
                                                                  Width="200"
                                                                  HorizontalAlignment="Left"
                                                                  Height="25">
                                                                <ComboBoxItem Content="{loc:Tr rule.target.file}"
                                                                              Tag="FileOnly"/>
                                                                <ComboBoxItem Content="{loc:Tr rule.target.folder}"
                                                                              Tag="DirectoryOnly"/>
                                                                <ComboBoxItem Content="{loc:Tr rule.target.both}"
                                                                              Tag="Both"/>
                                                        </ComboBox>
                                                </StackPanel>
                                        </TabItem>

                                        <!-- 【ファイルサイズ限定】 -->
                                        <TabItem Header="{loc:Tr rule.tab.size}">
                                                <StackPanel Margin="15">
                                                        <StackPanel Orientation="Horizontal"
                                                                    Margin="0,0,0,15">
                                                                <CheckBox Name="chkSizeMinEnabled"
                                                                          VerticalAlignment="Center"
                                                                          Margin="0,0,5,0"/>
                                                                <TextBox Name="txtSizeMinValue"
                                                                         Width="80"
                                                                         Height="25"
                                                                         Margin="0,0,5,0"
                                                                         VerticalContentAlignment="Center"/>
                                                                <ComboBox Name="cmbSizeMinUnit"
                                                                          Width="70"
                                                                          Height="25"
                                                                          Margin="0,0,10,0">
                                                                        <ComboBoxItem Content="{loc:Tr rule.unit.byte}"
                                                                                      Tag="Byte"/>
                                                                        <ComboBoxItem Content="KB"
                                                                                      Tag="KB"/>
                                                                        <ComboBoxItem Content="MB"
                                                                                      Tag="MB"/>
                                                                </ComboBox>
                                                                <TextBlock Text="{loc:Tr rule.size_min_note}"
                                                                           VerticalAlignment="Center"/>
                                                        </StackPanel>

                                                        <StackPanel Orientation="Horizontal"
                                                                    Margin="0,0,0,15">
                                                                <CheckBox Name="chkSizeMaxEnabled"
                                                                          VerticalAlignment="Center"
                                                                          Margin="0,0,5,0"/>
                                                                <TextBox Name="txtSizeMaxValue"
                                                                         Width="80"
                                                                         Height="25"
                                                                         Margin="0,0,5,0"
                                                                         VerticalContentAlignment="Center"/>
                                                                <ComboBox Name="cmbSizeMaxUnit"
                                                                          Width="70"
                                                                          Height="25"
                                                                          Margin="0,0,10,0">
                                                                        <ComboBoxItem Content="{loc:Tr rule.unit.byte}"
                                                                                      Tag="Byte"/>
                                                                        <ComboBoxItem Content="KB"
                                                                                      Tag="KB"/>
                                                                        <ComboBoxItem Content="MB"
                                                                                      Tag="MB"/>
                                                                </ComboBox>
                                                                <TextBlock Text="{loc:Tr rule.size_max_note}"
                                                                           VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                </StackPanel>
                                        </TabItem>

                                        <!-- 【タイムスタンプ限定】 -->
                                        <TabItem Header="{loc:Tr rule.tab.timestamp}">
                                                <StackPanel Margin="15">
                                                        <StackPanel Orientation="Horizontal"
                                                                    Margin="0,0,0,15">
                                                                <CheckBox Name="chkDateBeforeEnabled"
                                                                          VerticalAlignment="Center"
                                                                          Margin="0,0,5,0"/>
                                                                <DatePicker Name="dpDateBefore"
                                                                            Width="120"
                                                                            Height="25"
                                                                            Margin="0,0,10,0"/>
                                                                <TextBlock Text="{loc:Tr rule.ts.date_before}"
                                                                           VerticalAlignment="Center"/>
                                                        </StackPanel>

                                                        <StackPanel Orientation="Horizontal"
                                                                    Margin="0,0,0,25">
                                                                <CheckBox Name="chkDateAfterEnabled"
                                                                          VerticalAlignment="Center"
                                                                          Margin="0,0,5,0"/>
                                                                <DatePicker Name="dpDateAfter"
                                                                            Width="120"
                                                                            Height="25"
                                                                            Margin="0,0,10,0"/>
                                                                <TextBlock Text="{loc:Tr rule.ts.date_after}"
                                                                           VerticalAlignment="Center"/>
                                                        </StackPanel>

                                                        <StackPanel Orientation="Horizontal"
                                                                    Margin="0,0,0,15">
                                                                <CheckBox Name="chkTimeBeforeEnabled"
                                                                          VerticalAlignment="Center"
                                                                          Margin="0,0,5,0"/>
                                                                <TextBox Name="txtTimeBeforeValue"
                                                                         Width="50"
                                                                         Height="25"
                                                                         Margin="0,0,5,0"
                                                                         VerticalContentAlignment="Center"/>
                                                                <ComboBox Name="cmbTimeBeforeUnit"
                                                                          Width="80"
                                                                          Height="25"
                                                                          Margin="0,0,10,0">
                                                                        <ComboBoxItem Content="{loc:Tr rule.unit.day}"
                                                                                      Tag="Day"/>
                                                                        <ComboBoxItem Content="{loc:Tr rule.unit.week}"
                                                                                      Tag="Week"/>
                                                                        <ComboBoxItem Content="{loc:Tr rule.unit.month}"
                                                                                      Tag="Month"/>
                                                                </ComboBox>
                                                                <TextBlock Text="{loc:Tr rule.ts.rel_before}"
                                                                           VerticalAlignment="Center"/>
                                                        </StackPanel>

                                                        <StackPanel Orientation="Horizontal"
                                                                    Margin="0,0,0,15">
                                                                <CheckBox Name="chkTimeAfterEnabled"
                                                                          VerticalAlignment="Center"
                                                                          Margin="0,0,5,0"/>
                                                                <TextBox Name="txtTimeAfterValue"
                                                                         Width="50"
                                                                         Height="25"
                                                                         Margin="0,0,5,0"
                                                                         VerticalContentAlignment="Center"/>
                                                                <ComboBox Name="cmbTimeAfterUnit"
                                                                          Width="80"
                                                                          Height="25"
                                                                          Margin="0,0,10,0">
                                                                        <ComboBoxItem Content="{loc:Tr rule.unit.day}"
                                                                                      Tag="Day"/>
                                                                        <ComboBoxItem Content="{loc:Tr rule.unit.week}"
                                                                                      Tag="Week"/>
                                                                        <ComboBoxItem Content="{loc:Tr rule.unit.month}"
                                                                                      Tag="Month"/>
                                                                </ComboBox>
                                                                <TextBlock Text="{loc:Tr rule.ts.rel_after}"
                                                                           VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                </StackPanel>
                                        </TabItem>
                                </TabControl>
                        </Grid>
                </ScrollViewer>

                <!-- ============================== -->
                <!-- 下部ボタン (常に固定)          -->
                <!-- ============================== -->
                <StackPanel Grid.Row="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                        <Button Content="{loc:Tr common.save_close}"
                                Width="120"
                                Height="35"
                                Margin="0,0,10,0"
                                Background="#FF4CAF50"
                                Foreground="White"
                                FontWeight="Bold"
                                Click="BtnSave_Click"/>
                        <Button Content="{loc:Tr common.cancel}"
                                Width="90"
                                Height="35"
                                Click="BtnCancel_Click"/>
                </StackPanel>
        </Grid>
</Window>