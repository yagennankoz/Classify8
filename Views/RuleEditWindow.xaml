<Window x:Class="Classify8.Views.RuleEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="振り分け条件の編集"
        Width="680"
        MinHeight="400"
        SizeToContent="Height"
        MaxHeight="{Binding Path=Height, Source={x:Static SystemParameters.WorkArea}}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <!-- 0. スクロール領域 (設定項目) -->
            <RowDefinition Height="Auto"/>
            <!-- 1. ボタン領域 (常に下部に固定) -->
        </Grid.RowDefinitions>

        <!-- ============================== -->
        <!-- スクロール可能な設定エリア     -->
        <!-- ============================== -->
        <ScrollViewer Grid.Row="0"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled"
                Margin="0,0,0,15"
                Padding="0,0,10,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- メイン項目 -->
                    <RowDefinition Height="Auto"/>
                    <!-- タブ項目 -->
                </Grid.RowDefinitions>

                <!-- ============================== -->
                <!-- メイン項目 (常に表示)          -->
                <!-- ============================== -->
                <Grid Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 有効・名称 -->
                    <TextBlock Grid.Row="0"
                            Grid.Column="0"
                            Text="設定名:"
                            VerticalAlignment="Center"
                            FontWeight="Bold"/>
                    <StackPanel Grid.Row="0"
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Margin="0,0,0,10">
                        <CheckBox Name="chkIsEnabled"
                                Content="有効にする"
                                VerticalAlignment="Center"
                                Margin="0,0,15,0"/>
                        <TextBox Name="txtRuleName"
                                Width="300"
                                Height="25"
                                VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- 振り分け元 -->
                    <TextBlock Grid.Row="1"
                            Grid.Column="0"
                            Text="振り分け元:"
                            VerticalAlignment="Top"
                            Margin="0,5,0,0"
                            FontWeight="Bold"/>
                    <Border Grid.Row="1"
                            Grid.Column="1"
                            BorderBrush="LightGray"
                            BorderThickness="1"
                            Padding="10"
                            Margin="0,0,0,10">
                        <StackPanel>
                            <RadioButton Name="rbSourcePreset"
                                    Content="プリセットを使用"
                                    GroupName="SourceGrp"
                                    Checked="SourceMode_Changed"
                                    Unchecked="SourceMode_Changed"
                                    Margin="0,0,0,5"/>
                            <ComboBox Name="cmbSourcePreset"
                                    Height="25"
                                    Margin="20,0,0,10"
                                    SelectedValuePath="Id">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock>
                                            <Run Text="{Binding AliasName}"/>
                                            <Run Text=" ("
                                                    Foreground="Gray"/>
                                            <Run Text="{Binding DirectoryPath}"
                                                    Foreground="Gray"/>
                                            <Run Text=")"
                                                    Foreground="Gray"/>
                                        </TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <RadioButton Name="rbSourceCustom"
                                    Content="個別にフォルダを指定"
                                    GroupName="SourceGrp"
                                    Checked="SourceMode_Changed"
                                    Unchecked="SourceMode_Changed"
                                    Margin="0,0,0,5"/>
                            <Grid Margin="20,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Name="txtSourceCustom"
                                        Grid.Column="0"
                                        Height="25"
                                        Margin="0,0,5,0">
                                    <TextBox.ToolTip>
                                        <ToolTip>
                                            <TextBlock>
                                                <Run FontWeight="Bold"
                                                        Text="【パスに使える自動挿入タグ】"/><LineBreak/>
                                                <Run Text="/YYYY, /YY : 実行年 (4桁, 2桁)"/><LineBreak/>
                                                <Run Text="/MM : 実行月    /DD : 実行日"/><LineBreak/>
                                                <Run Text="/NAME : 設定名 (振り分け条件名)"/><LineBreak/>
                                                <Run Text="/COND : 検索条件 (スラッシュは除外)"/><LineBreak/>
                                                <Run Foreground="Gray"
                                                        Text="※大文字・小文字どちらでも使用可能"/><LineBreak/>
                                                <Run Foreground="#D32F2F"
                                                        Text="※ファイルの更新日時(/FYYなど)は振り分け先のみ使用可能です"/>
                                            </TextBlock>
                                        </ToolTip>
                                    </TextBox.ToolTip>
                                </TextBox>
                                <Button Name="btnSourceBrowse"
                                        Grid.Column="1"
                                        Content="参照..."
                                        Width="60"
                                        Height="25"
                                        Click="BtnSourceBrowse_Click"/>
                            </Grid>
                            <CheckBox Name="chkSearchSubDirs"
                                    Content="サブフォルダも対象とする"
                                    Margin="20,5,0,0"
                                    FontWeight="Bold"
                                    Foreground="#1976D2"/>
                        </StackPanel>
                    </Border>

                    <!-- 振り分け先 -->
                    <TextBlock Grid.Row="2"
                            Grid.Column="0"
                            Text="振り分け先:"
                            VerticalAlignment="Top"
                            Margin="0,5,0,0"
                            FontWeight="Bold"/>
                    <Border Grid.Row="2"
                            Grid.Column="1"
                            BorderBrush="LightGray"
                            BorderThickness="1"
                            Padding="10"
                            Margin="0,0,0,10">
                        <StackPanel>
                            <RadioButton Name="rbDestPreset"
                                    Content="プリセットを使用"
                                    GroupName="DestGrp"
                                    Checked="DestMode_Changed"
                                    Unchecked="DestMode_Changed"
                                    Margin="0,0,0,5"/>
                            <ComboBox Name="cmbDestPreset"
                                    Height="25"
                                    Margin="20,0,0,10"
                                    SelectedValuePath="Id">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock>
                                            <Run Text="{Binding AliasName}"/>
                                            <Run Text=" ("
                                                    Foreground="Gray"/>
                                            <Run Text="{Binding DirectoryPath}"
                                                    Foreground="Gray"/>
                                            <Run Text=")"
                                                    Foreground="Gray"/>
                                        </TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <RadioButton Name="rbDestCustom"
                                    Content="個別にフォルダを指定"
                                    GroupName="DestGrp"
                                    Checked="DestMode_Changed"
                                    Unchecked="DestMode_Changed"
                                    Margin="0,0,0,5"/>
                            <Grid Margin="20,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Name="txtDestCustom"
                                        Grid.Column="0"
                                        Height="25"
                                        Margin="0,0,5,0">
                                    <TextBox.ToolTip>
                                        <ToolTip>
                                            <TextBlock>
                                                <Run FontWeight="Bold"
                                                        Text="【パスに使える自動挿入タグ】"/><LineBreak/>
                                                <Run Text="/YYYY, /YY : 実行年 (4桁, 2桁)"/><LineBreak/>
                                                <Run Text="/MM : 実行月    /DD : 実行日"/><LineBreak/>
                                                <Run Text="/FYYYY, /FYY : ファイル更新年"/><LineBreak/>
                                                <Run Text="/FMM : ファイル更新月  /FDD : 更新日"/><LineBreak/>
                                                <Run Text="/NAME : 設定名 (振り分け条件名)"/><LineBreak/>
                                                <Run Text="/COND : 検索条件 (スラッシュは除外)"/><LineBreak/>
                                                <Run Foreground="Gray"
                                                        Text="※大文字・小文字どちらでも使用可能"/>
                                            </TextBlock>
                                        </ToolTip>
                                    </TextBox.ToolTip>
                                </TextBox>
                                <Button Name="btnDestBrowse"
                                        Grid.Column="1"
                                        Content="参照..."
                                        Width="60"
                                        Height="25"
                                        Click="BtnDestBrowse_Click"/>
                            </Grid>
                            <CheckBox Name="chkIsCopy"
                                    Content="振り分け(移動)ではなく、コピーする"
                                    Margin="20,5,0,0"
                                    FontWeight="Bold"
                                    Foreground="#D32F2F"/>
                        </StackPanel>
                    </Border>

                    <!-- 検索条件 -->
                    <TextBlock Grid.Row="3"
                            Grid.Column="0"
                            Text="検索条件:"
                            VerticalAlignment="Top"
                            Margin="0,3,0,0"
                            FontWeight="Bold"/>
                    <StackPanel Grid.Row="3"
                            Grid.Column="1"
                            Margin="0,0,0,10">
                        <TextBox Name="txtSearchCondition"
                                Height="25"/>
                        <TextBlock Text="※ワイルドカード (*, ?) が使用可能です。  演算子: /&amp; (AND)  /| (OR)  /! (NOT)  /( /) (カッコ)"
                                Foreground="Gray"
                                FontSize="11"
                                Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- ============================== -->
                <!-- タブ項目 (オプション)          -->
                <!-- ============================== -->
                <TabControl Grid.Row="1"
                        Margin="0,5,0,0">
                    <!-- 【一般】 -->
                    <TabItem Header="一般">
                        <StackPanel Margin="15">
                            <CheckBox Name="chkIgnoreCase"
                                    Content="大文字/小文字を区別しない"
                                    Margin="0,0,0,8"/>
                            <CheckBox Name="chkIgnoreWidth"
                                    Content="半角/全角を区別しない"
                                    Margin="0,0,0,8"/>
                            <CheckBox Name="chkIgnoreKana"
                                    Content="ひらがな/カタカナを区別しない"
                                    Margin="0,0,0,8"/>
                            <CheckBox Name="chkDoNotSaveHistory"
                                    Content="振り分け履歴に保存しない"
                                    Margin="0,0,0,20"/>

                            <TextBlock Text="振り分け対象:"
                                    FontWeight="Bold"
                                    Margin="0,0,0,5"/>
                            <ComboBox Name="cmbTargetType"
                                    Width="200"
                                    HorizontalAlignment="Left"
                                    Height="25">
                                <ComboBoxItem Content="ファイルのみ"
                                        Tag="FileOnly"/>
                                <ComboBoxItem Content="フォルダのみ"
                                        Tag="DirectoryOnly"/>
                                <ComboBoxItem Content="ファイル＋フォルダ"
                                        Tag="Both"/>
                            </ComboBox>
                        </StackPanel>
                    </TabItem>

                    <!-- 【ファイルサイズ限定】 -->
                    <TabItem Header="ファイルサイズ限定">
                        <StackPanel Margin="15">
                            <StackPanel Orientation="Horizontal"
                                    Margin="0,0,0,15">
                                <CheckBox Name="chkSizeMinEnabled"
                                        VerticalAlignment="Center"
                                        Margin="0,0,5,0"/>
                                <TextBox Name="txtSizeMinValue"
                                        Width="80"
                                        Height="25"
                                        Margin="0,0,5,0"
                                        VerticalContentAlignment="Center"/>
                                <ComboBox Name="cmbSizeMinUnit"
                                        Width="60"
                                        Height="25"
                                        Margin="0,0,10,0">
                                    <ComboBoxItem Content="バイト"
                                            Tag="Byte"/>
                                    <ComboBoxItem Content="KB"
                                            Tag="KB"/>
                                    <ComboBoxItem Content="MB"
                                            Tag="MB"/>
                                </ComboBox>
                                <TextBlock Text="以下のファイルを振り分け対象としない"
                                        VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal"
                                    Margin="0,0,0,15">
                                <CheckBox Name="chkSizeMaxEnabled"
                                        VerticalAlignment="Center"
                                        Margin="0,0,5,0"/>
                                <TextBox Name="txtSizeMaxValue"
                                        Width="80"
                                        Height="25"
                                        Margin="0,0,5,0"
                                        VerticalContentAlignment="Center"/>
                                <ComboBox Name="cmbSizeMaxUnit"
                                        Width="60"
                                        Height="25"
                                        Margin="0,0,10,0">
                                    <ComboBoxItem Content="バイト"
                                            Tag="Byte"/>
                                    <ComboBoxItem Content="KB"
                                            Tag="KB"/>
                                    <ComboBoxItem Content="MB"
                                            Tag="MB"/>
                                </ComboBox>
                                <TextBlock Text="以上のファイルを振り分け対象としない"
                                        VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </TabItem>

                    <!-- 【タイムスタンプ限定】 -->
                    <TabItem Header="タイムスタンプ限定">
                        <StackPanel Margin="15">
                            <StackPanel Orientation="Horizontal"
                                    Margin="0,0,0,15">
                                <CheckBox Name="chkDateBeforeEnabled"
                                        VerticalAlignment="Center"
                                        Margin="0,0,5,0"/>
                                <DatePicker Name="dpDateBefore"
                                        Width="120"
                                        Height="25"
                                        Margin="0,0,10,0"/>
                                <TextBlock Text="以前のファイルを振り分け対象としない"
                                        VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal"
                                    Margin="0,0,0,25">
                                <CheckBox Name="chkDateAfterEnabled"
                                        VerticalAlignment="Center"
                                        Margin="0,0,5,0"/>
                                <DatePicker Name="dpDateAfter"
                                        Width="120"
                                        Height="25"
                                        Margin="0,0,10,0"/>
                                <TextBlock Text="以降のファイルを振り分け対象としない"
                                        VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal"
                                    Margin="0,0,0,15">
                                <CheckBox Name="chkTimeBeforeEnabled"
                                        VerticalAlignment="Center"
                                        Margin="0,0,5,0"/>
                                <TextBox Name="txtTimeBeforeValue"
                                        Width="50"
                                        Height="25"
                                        Margin="0,0,5,0"
                                        VerticalContentAlignment="Center"/>
                                <ComboBox Name="cmbTimeBeforeUnit"
                                        Width="50"
                                        Height="25"
                                        Margin="0,0,10,0">
                                    <ComboBoxItem Content="日"
                                            Tag="Day"/>
                                    <ComboBoxItem Content="週"
                                            Tag="Week"/>
                                    <ComboBoxItem Content="月"
                                            Tag="Month"/>
                                </ComboBox>
                                <TextBlock Text="以前のファイルを振り分け対象としない"
                                        VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal"
                                    Margin="0,0,0,15">
                                <CheckBox Name="chkTimeAfterEnabled"
                                        VerticalAlignment="Center"
                                        Margin="0,0,5,0"/>
                                <TextBox Name="txtTimeAfterValue"
                                        Width="50"
                                        Height="25"
                                        Margin="0,0,5,0"
                                        VerticalContentAlignment="Center"/>
                                <ComboBox Name="cmbTimeAfterUnit"
                                        Width="50"
                                        Height="25"
                                        Margin="0,0,10,0">
                                    <ComboBoxItem Content="日"
                                            Tag="Day"/>
                                    <ComboBoxItem Content="週"
                                            Tag="Week"/>
                                    <ComboBoxItem Content="月"
                                            Tag="Month"/>
                                </ComboBox>
                                <TextBlock Text="以降のファイルを振り分け対象としない"
                                        VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </TabItem>
                </TabControl>
            </Grid>
        </ScrollViewer>

        <!-- ============================== -->
        <!-- 下部ボタン (常に固定)          -->
        <!-- ============================== -->
        <StackPanel Grid.Row="1"
                Orientation="Horizontal"
                HorizontalAlignment="Right">
            <Button Content="保存して閉じる"
                    Width="120"
                    Height="35"
                    Margin="0,0,10,0"
                    Background="#FF4CAF50"
                    Foreground="White"
                    FontWeight="Bold"
                    Click="BtnSave_Click"/>
            <Button Content="キャンセル"
                    Width="90"
                    Height="35"
                    Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>