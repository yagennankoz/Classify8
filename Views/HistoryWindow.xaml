<Window x:Class="Classify8.Views.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Classify8.Localization"
        Title="{loc:Tr history.title}"
        Height="500"
        Width="1000"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="10">
        <DataGrid Name="dgHistory"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Auto">

            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="{loc:Tr common.open_source}"
                              Click="MenuOpenSource_Click"/>
                    <MenuItem Header="{loc:Tr common.open_dest}"
                              Click="MenuOpenDest_Click"/>
                    <Separator/>
                    <MenuItem Header="{loc:Tr history.open_rule}"
                              Click="MenuOpenRule_Click"/>
                </ContextMenu>
            </DataGrid.ContextMenu>

            <DataGrid.Columns>
                <DataGridTextColumn Header="{loc:Tr history.col.time}"
                                    Binding="{Binding Timestamp, StringFormat=yyyy/MM/dd HH:mm:ss}"
                                    Width="140"/>
                <DataGridTextColumn Header="{loc:Tr history.col.status}"
                                    Binding="{Binding StatusDisplay}"
                                    Width="150"/>
                <DataGridTextColumn Header="{loc:Tr history.col.rule}"
                                    Binding="{Binding RuleName}"
                                    Width="150"/>
                <DataGridTextColumn Header="{loc:Tr history.col.file}"
                                    Binding="{Binding FileName}"
                                    Width="150"/>
                <DataGridTextColumn Header="{loc:Tr history.col.new_file}"
                                    Binding="{Binding NewFileName}"
                                    Width="150"/>
                <DataGridTextColumn Header="{loc:Tr common.source}"
                                    Binding="{Binding SourceDir}"
                                    Width="150"/>
                <DataGridTextColumn Header="{loc:Tr common.dest}"
                                    Binding="{Binding DestDir}"
                                    Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>