<Window x:Class="Classify8.Views.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="振り分け履歴"
        Height="500"
        Width="1000"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <DataGrid Name="dgHistory"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Auto">

            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="振り分け元フォルダを開く"
                              Click="MenuOpenSource_Click"/>
                    <MenuItem Header="振り分け先フォルダを開く"
                              Click="MenuOpenDest_Click"/>
                    <Separator/>
                    <MenuItem Header="振り分けルールを開く"
                              Click="MenuOpenRule_Click"/>
                </ContextMenu>
            </DataGrid.ContextMenu>

            <DataGrid.Columns>
                <DataGridTextColumn Header="日時"
                                    Binding="{Binding Timestamp, StringFormat=yyyy/MM/dd HH:mm:ss}"
                                    Width="140"/>
                <DataGridTextColumn Header="状態"
                                    Binding="{Binding Status}"
                                    Width="60"/>
                <DataGridTextColumn Header="ルール名"
                                    Binding="{Binding RuleName}"
                                    Width="150"/>
                <DataGridTextColumn Header="ファイル名"
                                    Binding="{Binding FileName}"
                                    Width="150"/>
                <DataGridTextColumn Header="変更後ファイル名"
                                    Binding="{Binding NewFileName}"
                                    Width="150"/>
                <DataGridTextColumn Header="振り分け元"
                                    Binding="{Binding SourceDir}"
                                    Width="150"/>
                <DataGridTextColumn Header="振り分け先"
                                    Binding="{Binding DestDir}"
                                    Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>